<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\HeatFlow.Application\HeatFlow.Application.csproj" />
    <ProjectReference Include="..\HeatFlow.Infrastructure\HeatFlow.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.2" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.MSSqlServer" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>


  <!-- Serwer docelowy (CT 200) to Linux. Publish bez RID albo pod win-x64 daje artefakt,
       ktory na serwerze WSTAJE i nasluchuje, a wywala sie dopiero przy pierwszym zapisie
       do bazy: PlatformNotSupportedException (windowsowy wariant Microsoft.Data.SqlClient).
       Build z RID ma tez wkompilowana platforme docelowa, wiec domyslne logowanie dodaje
       EventLog, ktorego na Linuksie nie ma. Awaria 2026-08-16 - ubuntuserver/README.md, sekcja 6.1.
       Dlatego publish bez jawnego RID dostaje linux-x64 automatycznie. -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true' And '$(RuntimeIdentifier)' == ''">
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <!-- Zapora na obcy RID podany jawnie. Swiadome obejscie: -p:PozwolNaObcyRid=true -->
  <Target Name="SprawdzRidPrzedPublikacja" BeforeTargets="Publish"
          Condition="'$(RuntimeIdentifier)' != 'linux-x64' And '$(PozwolNaObcyRid)' != 'true'">
    <Error Text="Publish dla RID '$(RuntimeIdentifier)' - serwerem docelowym jest Linux (CT 200). Uzyj: dotnet publish -c Release -r linux-x64 --self-contained false -o &lt;folder&gt;. Kontrola artefaktu: plik bez rozszerzenia zamiast .exe. Szczegoly: ubuntuserver/README.md sekcja 6.1." />
  </Target>

</Project>
